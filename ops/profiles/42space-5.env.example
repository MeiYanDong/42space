# Bot5 profile template. Copy to /etc/42space/profiles/42space-5.env,
# fill secrets on the server, then switch DRY_RUN/EXECUTE for live mode.

BOT_NAME=Bot5 Console
EVENT_PROFILE_ROLE=bot2_like
BOT_ENTRYPOINT=event:arm
BOT_SYSTEMD_SERVICE=42space-event@42space-5.service
DASHBOARD_PORT=4246
DASHBOARD_HOST=0.0.0.0

DRY_RUN=1
EXECUTE=0
I_UNDERSTAND_42_PRICE_MARKET_RISK=NO
I_AM_NOT_IN_RESTRICTED_JURISDICTION=NO

PRIVATE_KEY=<BOT5_PRIVATE_KEY>
WALLET_ADDRESS=<BOT5_WALLET_ADDRESS>
FEISHU_WEBHOOK=<BOT5_FEISHU_WEBHOOK>
DASHBOARD_ADMIN_TOKEN=

BSC_RPC_URL=<BOT5_CHAINSTACK_HTTP_RPC>
BSC_WS_URL=<BOT5_CHAINSTACK_WSS_RPC>
CHAINSTACK_BSC_RPC_URL=<BOT5_CHAINSTACK_HTTP_RPC>
CHAINSTACK_BSC_WS_URL=<BOT5_CHAINSTACK_WSS_RPC>
BROADCAST_RPC_URLS=<BOT5_CHAINSTACK_HTTP_RPC>

RUNTIME_CONFIG_FILE=/opt/42space/data/42space-5/runtime-config.json
MARKET_FOLLOW_FILE=/opt/42space/data/42space-5/market-follow.json
ALERT_STATE_FILE=/opt/42space/data/42space-5/alert-state.json
STATE_FILE=/opt/42space/data/42space-5/seen-markets.json
FILLS_FILE=/opt/42space/data/42space-5/fills.jsonl
MARKET_DECISIONS_FILE=/opt/42space/data/42space-5/market-decisions.jsonl
AUTO_SELL_STATE_FILE=/opt/42space/data/42space-5/auto-sell-seen.json
AUTO_SELL_POSITION_STATE_FILE=/opt/42space/data/42space-5/auto-sell-positions.json
AUTO_SELL_CIRCUIT_STATE_FILE=/opt/42space/data/42space-5/auto-sell-circuit.json
DASHBOARD_ACTIONS_FILE=/opt/42space/data/42space-5/dashboard-actions.jsonl

EVENT_DISCOVERY=feed
EVENT_DISCOVERY_FEED_FILE=/opt/42space/output/event-discovery-feed.jsonl
EVENT_DISCOVERY_FEED_POLL_MS=1000
EVENT_DISCOVERY_FEED_TAIL_BYTES=2097152
REST_DISCOVERY_ENABLED=1
REST_DISCOVERY_POLL_MS=1000

EVENT_INTEL_BUY_FILTER=strong
EVENT_INTEL_BUY_FILE=/opt/42space/output/event-intel.jsonl
EVENT_DISPLAY_FILTER_RULES=price,daily_fixed_template,sports_total_goals,sports_goal_differential
EVENT_DISPLAY_INCLUDE_RULES=

STAKE_USDT=10
STAKE_PER_OUTCOME_USDT=10
MAX_STAKE_USDT=10
MAX_MARKET_STAKE_USDT=30
MAX_BATCH_STAKE_USDT=30
MAX_OUTCOMES_PER_MARKET=12
EVENT_OUTCOME_SELECTION=middle
EVENT_OUTCOME_COUNT=3
EVENT_OUTCOME_SELECTION_FALLBACK=token_order
EVENT_BUY_MODE=fast
BUNDLE_DUE_MARKETS=0
EVENT_MAX_DUE_MARKETS_PER_OPEN=1
EVENT_PRICE_GATE_ENABLED=0
EVENT_OPEN_WINDOW_SECONDS=20
OPEN_BROADCAST_DELAY_MS=19900

GAS_PRICE_GWEI=6
FANOUT_BROADCAST=1
BROADCAST_TIMEOUT_MS=1200
REBROADCAST_INTERVAL_MS=100
REBROADCAST_DURATION_MS=2500
PRE_SIGN_FAST_TX=1
PRE_SIGN_WINDOW_MS=60000
OPEN_BROADCAST_SCHEDULE_AHEAD_MS=60000
OPEN_BROADCAST_SPIN_MS=15
FAST_SKIP_PREFLIGHT=1
FAST_SKIP_DUE_REST_HYDRATION=1
FAST_NONCE_MANAGER=1
NONCE_SYNC_BEFORE_PRESIGN=1
NONCE_SYNC_MIN_INTERVAL_MS=250
WAIT_FOR_RECEIPT=0
ASYNC_RECEIPT_WATCH=1
RECEIPT_WATCH_TIMEOUT_MS=120000
RECEIPT_WATCH_POLLING_MS=1000

AUTO_APPROVE_ROUTER_ON_START=1
ARM_WAIT_FOR_FUNDING=1
ARM_FUNDING_RETRY_MS=60000
ARM_CATCH_UP_AFTER_FUNDING=1
WATCH_FUNDING_MODE=next_batch

AUTO_SELL_ENABLED=1
AUTO_SELL_STRATEGY=open_timed_exit
AUTO_SELL_OPEN_EXIT_DELAY_SECONDS=25
AUTO_SELL_OPEN_EXIT_PERCENT=100
AUTO_SELL_GAS_PRICE_GWEI=0.15
AUTO_SELL_FAST_OPEN_EXIT_ENABLED=1
AUTO_SELL_FAST_OPEN_EXIT_MIN_DELAY_MS=24500
AUTO_SELL_FAST_OPEN_EXIT_MAX_DELAY_MS=26000
AUTO_SELL_FAST_OPEN_EXIT_MONITOR_PAUSE_MS=45000
AUTO_SELL_STOP_LOSS_ENABLED=1
AUTO_SELL_STOP_LOSS_PERCENT=10
AUTO_SELL_STOP_LOSS_SELL_PERCENT=100
AUTO_SELL_POLL_MS=1000
AUTO_SELL_BUY_GUARD_BEFORE_MS=120000
AUTO_SELL_BUY_GUARD_AFTER_MS=10000
AUTO_SELL_PREAPPROVE_OPERATOR=1
AUTO_SELL_REQUIRE_PREAPPROVED_OPERATOR=1
AUTO_SELL_MIN_BNB_RESERVE=0.003
AUTO_SELL_CIRCUIT_BREAKER_ENABLED=1
