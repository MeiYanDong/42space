[Unit]
Description=42space shared RPC observer shadow equivalence report
After=42space-shared-rpc-observer.service

[Service]
Type=oneshot
WorkingDirectory=/opt/42space
ExecStart=/usr/bin/node /opt/42space/scripts/shared-rpc-observer-report.js
Nice=15
IOSchedulingClass=idle
CPUWeight=5
IOWeight=5
MemoryMax=256M
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
UMask=0077
