# Default mode is dry-run. Real buys require all three switches:
# DRY_RUN=0
# EXECUTE=1
# I_UNDERSTAND_42_PRICE_MARKET_RISK=YES
# I_AM_NOT_IN_RESTRICTED_JURISDICTION=YES
DRY_RUN=1
EXECUTE=0
I_UNDERSTAND_42_PRICE_MARKET_RISK=NO
I_AM_NOT_IN_RESTRICTED_JURISDICTION=NO
BOT_NAME=42space
EVENT_PROFILE_ROLE=
BOT_ENTRYPOINT=event:watch

FORTYTWO_REST_URL=https://rest.ft.42.space
# Project env overrides ~/.codex/secrets/evm-rpc-providers.env.
# Supported HTTP aliases: BSC_RPC_URL, CHAINSTACK_BSC_RPC_URL, ANKR_BSC_RPC_URL.
# Supported WSS aliases: BSC_WS_URL, CHAINSTACK_BSC_WS_URL, ANKR_BSC_WS_URL, ANKR_BSC_WS_RPC_URL.
# Binance dataseed rejects eth_getLogs; publicnode supports controller event discovery.
BSC_RPC_URL=https://bsc-rpc.publicnode.com
BSC_WS_URL=wss://bsc-rpc.publicnode.com
PRIVATE_KEY=
WALLET_ADDRESS=
PRIVATE_KEY_KEYCHAIN_SERVICE=42space-event-bot-private-key
PRIVATE_KEY_KEYCHAIN_ACCOUNT=42space
DISABLE_KEYCHAIN_PRIVATE_KEY=0

# Daily volume markets currently use BTC; 8-hour price range markets currently use Bitcoin.
TARGET_TOPIC=BTC
TARGET_QUESTION_REGEX=BTC.*(Futures Daily Volume|Price|USDT)
TARGET_OUTCOME_REGEX=
MARKET_QUESTION_ALLOWLIST_REGEX=
# Optional buy-only question allowlist. Unlike MARKET_QUESTION_ALLOWLIST_REGEX,
# this does not hide non-matching events from the dashboard.
MARKET_BUY_QUESTION_ALLOWLIST_REGEX=
STRATEGY=binance_volume_projection

STAKE_USDT=10
STAKE_PER_OUTCOME_USDT=10
MAX_STAKE_USDT=10
MAX_MARKET_STAKE_USDT=30
MAX_BATCH_STAKE_USDT=30
MAX_OUTCOMES_PER_MARKET=12
EVENT_OUTCOME_SELECTION=middle
EVENT_OUTCOME_COUNT=3
EVENT_OUTCOME_SELECTION_FALLBACK=token_order
EVENT_PLANNED_BUYS_FILE=data/planned-buys.json
EVENT_BUY_MODE=fast
EVENT_DISCOVERY=ws
EVENT_DISCOVERY_FEED_FILE=output/event-discovery-feed.jsonl
EVENT_DISCOVERY_FEED_POLL_MS=1000
EVENT_DISCOVERY_FEED_TAIL_BYTES=2097152
REST_DISCOVERY_ENABLED=1
REST_DISCOVERY_POLL_MS=1000
FEISHU_ALERTS_ENABLED=1
FEISHU_WEBHOOK=
FEISHU_ALERT_COOLDOWN_MS=60000
ALERT_STATE_FILE=data/alert-state.json

# Read-only intelligence sidecar for newly discovered 42 events.
# Fixed 08:00 Beijing daily/weekly/monthly templates are archived without external search.
EVENT_INTEL_ENABLED=1
EVENT_INTEL_OUTPUT_DIR=output/event-intel
EVENT_INTEL_FILE=output/event-intel.jsonl
EVENT_INTEL_SEEN_FILE=output/event-intel-seen.json
EVENT_INTEL_SKIP_FIXED=1
EVENT_INTEL_SKIP_PRICE=1
EVENT_INTEL_CREATED_AT_OPEN_THRESHOLD_MINUTES=31
EVENT_INTEL_SEARCH_PROVIDER=auto
EVENT_INTEL_MAX_RESULTS=5
EVENT_INTEL_TIMEOUT_MS=8000
EVENT_INTEL_SEARCH_WINDOW_HOURS=24
BRAVE_SEARCH_API_KEY=
SERPAPI_API_KEY=
EVENT_INTEL_WEB_SEARCH_URL_TEMPLATE=
EVENT_INTEL_WEB_SEARCH_HEADERS_JSON=
EVENT_INTEL_X_PROVIDER=auto
# Preferred local skill-backed provider: twitterapi-io. Keep the key in env only.
TWITTERAPI_IO_KEY=
EVENT_INTEL_TWITTERAPI_IO_BASE_URL=https://api.twitterapi.io
EVENT_INTEL_X_QUERY_TYPE=Latest
EVENT_INTEL_X_BEARER_TOKEN=
TWITTER_BEARER_TOKEN=
X_BEARER_TOKEN=
EVENT_INTEL_X_SEARCH_URL_TEMPLATE=
EVENT_INTEL_X_HEADERS_JSON=
EVENT_INTEL_NOTIFY_NON_TEMPLATE=1
EVENT_INTEL_NOTIFY_PRICE_EVENTS=0
# Comma-separated display/notification filters. Empty runtime value means show all monitored data-complete events.
EVENT_DISPLAY_FILTER_RULES=price,daily_fixed_template,sports_total_goals,sports_goal_differential
# Optional positive display allowlist. Example: daily_fixed_template shows only daily template events.
EVENT_DISPLAY_INCLUDE_RULES=
# Bot1 target for non-template new-event alerts. Keep the real webhook in server env only.
EVENT_INTEL_FEISHU_WEBHOOK=
# Optional extra Bot2 target for all non-filtered new-event alerts from a shared watcher.
EVENT_INTEL_BOT2_FEISHU_WEBHOOK=
EVENT_INTEL_BOT2_RUNTIME_CONFIG_FILE=
EVENT_INTEL_BOT2_DISPLAY_FILTER_RULES=
EVENT_INTEL_BOT2_NOTIFY_BOT_NAME=Bot2
# Optional extra Bot5 target. Use EVENT_PROFILE_ROLE=bot2_like in the Bot5 profile.
EVENT_INTEL_BOT5_FEISHU_WEBHOOK=
EVENT_INTEL_BOT5_RUNTIME_CONFIG_FILE=
EVENT_INTEL_BOT5_DISPLAY_FILTER_RULES=
EVENT_INTEL_BOT5_NOTIFY_BOT_NAME=Bot5
EVENT_INTEL_NOTIFY_BOT_NAME=42space
EVENT_INTEL_NOTIFY_SEEN_FILE=output/event-intel-notify-seen.json
EVENT_INTEL_NOTIFY_STRONG=0
PREMIUM_WATCH_PROBES_ENABLED=1
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=4242
DASHBOARD_ACTIONS_FILE=data/dashboard-actions.jsonl
